# Environment variables
.env
.env.*
!.env.example

# Credentials and secret files
credentials/
*.pem
*.key
*.p12
service-account*.json

# Client-private files. Client manifests and artifacts are local by default.
clients/*
!clients/.gitkeep

# Generated reports and client research artifacts
# Existing tracked files remain tracked. Review and force-add only sanitized artifacts intentionally.
reports/*
!reports/.gitkeep
research/raw/*
!research/raw/.gitkeep
research/processed/*
!research/processed/.gitkeep
research/snapshots/*
!research/snapshots/.gitkeep
research/cache/*
!research/cache/.gitkeep

# Sanitized runtime logs only; do not retain secrets or client payloads.
logs/*
!logs/.gitkeep

# Operating-system files
.DS_Store
Thumbs.db

# Temporary files and logs
*.log
*.tmp

# Python runtime artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
.venv/
build/
dist/
*.egg-info/

# Local VS Code settings
.vscode/settings.json
