{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seo-agency-os.local/schemas/monitoring-event.schema.json",
  "title": "SEO Monitoring Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "project_id", "source", "signal", "entity", "observed_at", "baseline_window", "comparison_window", "expected_value", "current_value", "delta", "threshold_rule", "confidence", "classification", "deduplication_key", "state", "evidence_references"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "event_id": {"type": "string", "pattern": "^MONITOR-[0-9]{2,}$"},
    "project_id": {"type": "string", "minLength": 3},
    "source": {"type": "string", "minLength": 2},
    "signal": {"type": "string", "minLength": 2},
    "entity": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "baseline_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_date", "end_date"],
      "properties": {
        "start_date": {"type": "string", "format": "date"},
        "end_date": {"type": "string", "format": "date"}
      }
    },
    "comparison_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_date", "end_date"],
      "properties": {
        "start_date": {"type": "string", "format": "date"},
        "end_date": {"type": "string", "format": "date"}
      }
    },
    "expected_value": {"type": ["number", "string", "boolean", "null"]},
    "current_value": {"type": ["number", "string", "boolean", "null"]},
    "delta": {"type": ["number", "null"]},
    "threshold_rule": {"type": "string", "minLength": 3},
    "confidence": {"type": "string", "enum": ["low", "medium", "high"]},
    "classification": {"type": "string", "enum": ["informational-change", "watch-item", "seo-opportunity", "urgent-issue", "critical-incident"]},
    "deduplication_key": {"type": "string", "minLength": 3},
    "suppressed_until": {"type": ["string", "null"], "format": "date-time"},
    "state": {"type": "string", "enum": ["open", "acknowledged", "resolved", "suppressed"]},
    "evidence_references": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
