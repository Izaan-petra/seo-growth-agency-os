{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seo-agency-os.local/schemas/specialist-finding.schema.json",
  "title": "SEO Specialist Finding",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "finding_id", "project_id", "brief_id", "workstream", "finding_type", "statement", "evidence", "affected_assets", "recommended_direction", "impact", "confidence", "effort", "dependencies", "validation"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "finding_id": {"type": "string", "pattern": "^[A-Z]+-[0-9]{2,}$"},
    "project_id": {"type": "string", "minLength": 3},
    "brief_id": {"type": "string", "minLength": 3},
    "workstream": {"type": "string", "pattern": "^[a-z0-9-]{1,63}$"},
    "finding_type": {"type": "string", "enum": ["issue", "opportunity", "observation", "validation-required"]},
    "statement": {"type": "string", "minLength": 3},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reference", "evidence_tier", "observed_at", "limitations"],
        "properties": {
          "reference": {"type": "string", "minLength": 1},
          "evidence_tier": {"type": "string", "enum": ["first-party", "third-party", "public"]},
          "observed_at": {"type": "string", "format": "date-time"},
          "limitations": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "affected_assets": {"type": "array", "items": {"type": "string"}},
    "recommended_direction": {"type": "string", "minLength": 3},
    "impact": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
    "confidence": {"type": "string", "enum": ["low", "medium", "high"]},
    "effort": {"type": "string", "enum": ["low", "medium", "high"]},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "validation": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
