{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seo-agency-os.local/schemas/specialist-brief.schema.json",
  "title": "SEO Specialist Brief",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "brief_id", "project_id", "engagement_type", "skill", "objective", "scope", "exclusions", "targets", "evidence_references", "dependencies", "expected_outputs", "acceptance_criteria"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "brief_id": {"type": "string", "minLength": 3},
    "project_id": {"type": "string", "minLength": 3},
    "engagement_type": {"type": "string", "minLength": 3},
    "skill": {"type": "string", "pattern": "^[a-z0-9-]{1,63}$"},
    "objective": {"type": "string", "minLength": 3},
    "scope": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "exclusions": {"type": "array", "items": {"type": "string"}},
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["urls", "markets", "languages", "devices"],
      "properties": {
        "urls": {"type": "array", "items": {"type": "string"}},
        "markets": {"type": "array", "items": {"type": "string"}},
        "languages": {"type": "array", "items": {"type": "string"}},
        "devices": {"type": "array", "items": {"type": "string", "enum": ["mobile", "desktop", "tablet"]}},
        "start_date": {"type": ["string", "null"], "format": "date"},
        "end_date": {"type": ["string", "null"], "format": "date"}
      }
    },
    "evidence_references": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "expected_outputs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
