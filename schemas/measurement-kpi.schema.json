{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seo-agency-os.local/schemas/measurement-kpi.schema.json",
  "title": "SEO Measurement KPI",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kpi_id", "project_id", "name", "business_question", "definition", "formula", "source", "grain", "filters", "baseline", "thresholds", "cadence", "limitations"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "kpi_id": {"type": "string", "pattern": "^MEASURE-[0-9]{2,}$"},
    "project_id": {"type": "string", "minLength": 3},
    "name": {"type": "string", "minLength": 2},
    "business_question": {"type": "string", "minLength": 3},
    "definition": {"type": "string", "minLength": 3},
    "formula": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 2},
    "grain": {"type": "string", "minLength": 2},
    "filters": {"type": "object"},
    "timezone": {"type": ["string", "null"]},
    "currency": {"type": ["string", "null"]},
    "attribution": {"type": ["string", "null"]},
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_date", "end_date", "value", "comparison_rule"],
      "properties": {
        "start_date": {"type": "string", "format": "date"},
        "end_date": {"type": "string", "format": "date"},
        "value": {"type": ["number", "null"]},
        "comparison_rule": {"type": "string"}
      }
    },
    "thresholds": {"type": "array", "items": {"type": "string"}},
    "cadence": {"type": "string", "enum": ["daily", "weekly", "monthly", "quarterly", "event-driven"]},
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
