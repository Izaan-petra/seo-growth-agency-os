{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seo-agency-os.local/schemas/backlink-prospect.schema.json",
  "title": "SEO Backlink Prospect",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "prospect_id", "project_id", "domain", "source_url", "evidence_references", "qualification", "risk_flags", "target_page", "linkable_asset", "approval_status"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "prospect_id": {"type": "string", "pattern": "^AUTH-[0-9]{2,}$"},
    "project_id": {"type": "string", "minLength": 3},
    "domain": {"type": "string", "minLength": 3},
    "source_url": {"type": "string", "format": "uri"},
    "evidence_references": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topical_relevance", "audience_fit", "editorial_quality", "traffic_plausibility", "geographic_fit", "overall"],
      "properties": {
        "topical_relevance": {"type": "integer", "minimum": 1, "maximum": 5},
        "audience_fit": {"type": "integer", "minimum": 1, "maximum": 5},
        "editorial_quality": {"type": "integer", "minimum": 1, "maximum": 5},
        "traffic_plausibility": {"type": "integer", "minimum": 1, "maximum": 5},
        "geographic_fit": {"type": "integer", "minimum": 1, "maximum": 5},
        "real_site_plausibility": {"type": "integer", "minimum": 1, "maximum": 5},
        "organic_visibility_evidence": {"type": "integer", "minimum": 1, "maximum": 5},
        "placement_relevance": {"type": "integer", "minimum": 1, "maximum": 5},
        "manipulation_risk": {"type": "string", "enum": ["low", "medium", "high"]},
        "overall": {"type": "string", "enum": ["reject", "review", "qualified"]}
      }
    },
    "risk_flags": {"type": "array", "items": {"type": "string"}},
    "target_page": {"type": ["string", "null"]},
    "linkable_asset": {"type": ["string", "null"]},
    "opportunity_type": {"type": "string", "enum": ["reclamation", "lost-link-reclamation", "unlinked-mention", "broken-link", "broken-link-replacement", "resource-page", "resource", "competitor-intersect", "competitor-gap", "link-gap", "partner-association", "partnership", "expert-contribution", "digital-pr", "linkable-asset", "other"]},
    "approval_status": {"type": "string", "enum": ["not-reviewed", "approved-for-preparation", "rejected", "approved-for-human-outreach"]}
  }
}
