{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seo-agency-os.local/schemas/ingestion-manifest.schema.json",
  "title": "SEO OS Ingestion Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ingestion_id", "project_id", "authorization_id", "source", "record_type", "acquisition_method", "retrieved_at", "fields", "raw_artifact", "row_count", "status", "limitations"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "ingestion_id": {"type": "string", "minLength": 3},
    "project_id": {"type": "string", "minLength": 3},
    "authorization_id": {"type": "string", "minLength": 3},
    "source": {"type": "string", "minLength": 2},
    "record_type": {"type": "string", "minLength": 2},
    "resource_id": {"type": "string"},
    "acquisition_method": {"type": "string", "enum": ["api", "connector", "export", "screenshot", "public-research"]},
    "retrieved_at": {"type": "string", "format": "date-time"},
    "period": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "start_date": {"type": "string", "format": "date"},
        "end_date": {"type": "string", "format": "date"}
      },
      "required": ["start_date", "end_date"]
    },
    "filters": {"type": "object"},
    "metadata": {"type": "object"},
    "fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "raw_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "media_type", "checksum_sha256", "size_bytes"],
      "properties": {
        "relative_path": {"type": "string", "minLength": 3},
        "media_type": {"type": "string", "minLength": 3},
        "checksum_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "row_count": {"type": "integer", "minimum": 0},
    "status": {"type": "string", "enum": ["complete", "partial", "failed", "quarantined"]},
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "message", "retryable"],
        "properties": {
          "category": {"type": "string"},
          "message": {"type": "string"},
          "retryable": {"type": "boolean"}
        }
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
